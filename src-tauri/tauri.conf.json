{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yaptic",
  "version": "0.1.0",
  "identifier": "io.github.iniandrew.yaptic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Yaptic Settings",
        "width": 520,
        "height": 780,
        "visible": false,
        "minWidth": 460,
        "minHeight": 480
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "Yaptic Pill",
        "width": 440,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Chrisdion Andrew. MIT License.",
    "category": "Productivity",
    "shortDescription": "Push-to-talk voice dictation for macOS",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
